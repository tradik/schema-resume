<?xml version="1.0" encoding="UTF-8"?>
<!-- PHP package tests. composer.json is at the repository root (Packagist only reads it there). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="php">
            <directory>packages/php/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/php/src</directory>
        </include>
    </source>
</phpunit>
