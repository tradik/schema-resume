{
  "name": "schema-resume",
  "version": "1.3.0",
  "private": true,
  "description": "A comprehensive JSON-LD Schema for CV/Resume parsing and validation with work authorization and tools tracking",
  "main": "schema.json",
  "workspaces": [
    "packages/npm"
  ],
  "scripts": {
    "build:assets": "node tools/build-icons.mjs && node tools/build-vendor.mjs",
    "build": "npm run build:assets && ssg --config .ssg.yaml --clean",
    "start": "npm run build:assets && ssg --config .ssg.yaml --clean --http --watch",
    "clean": "rm -rf output templates/schema-resume/js/vendor templates/schema-resume/partials/icons.html editor/vendor",
    "validate": "ajv compile -s schema.json -c ajv-formats",
    "validate:example": "ajv validate -s schema.json -c ajv-formats -d example.json -d example-minimal.json",
    "test": "npm run validate && npm run validate:example",
    "format:check": "node -e \"JSON.parse(require('fs').readFileSync('schema.json', 'utf8'))\" && node -e \"JSON.parse(require('fs').readFileSync('example.json', 'utf8'))\"",
    "lint": "npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradik/schema-resume.git"
  },
  "keywords": [
    "json-schema",
    "resume",
    "cv",
    "curriculum-vitae",
    "parser",
    "validation",
    "json-ld",
    "schema",
    "job",
    "career",
    "professional"
  ],
  "author": "Tradik",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tradik/schema-resume/issues"
  },
  "homepage": "https://schema-resume.org/",
  "devDependencies": {
    "@tradik/xslt-processor": "^1.0.3",
    "ajv": "^8.20.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.1",
    "lucide-static": "^1.28.0",
    "mermaid": "^11.16.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
